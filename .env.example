# 复制为 .env 后填真实值：cp .env.example .env
# .env 已被 .gitignore 拦截，绝不提交、绝不打进镜像。

# ================= 大模型生成（一律云端） =================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# strict JSON Schema 走 beta 端点
DEEPSEEK_BETA_BASE_URL=https://api.deepseek.com/beta
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=30
# SDK 自动重试次数（只对 429/5xx/超时生效；Day 6 再加显式退避与错误分类日志）
LLM_MAX_RETRIES=2
# 成本估算单价（每 100 万 token）。留空 = 不估算，代码不会替你猜价格。
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=
LLM_PRICE_CURRENCY=CNY

# ================= 嵌入（本地只做轻量实验） =================
# siliconflow = 云端 BAAI/bge-m3（1024 维，推荐）
# ollama      = 本地 nomic-embed-text（768 维，约 274MB）
# 注意：两种维度不同，必须使用不同的 CHROMA_COLLECTION
EMBED_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_BATCH_SIZE=32

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ================= 向量库 =================
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=kb_bge_m3
TOP_K=4
SCORE_THRESHOLD=0.35

# ================= 服务 =================
APP_ENV=dev
APP_VERSION=0.1.0
MAX_AGENT_STEPS=5
REQUEST_TIMEOUT_S=30
UPLOAD_MAX_MB=10
